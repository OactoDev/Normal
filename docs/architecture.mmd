flowchart LR
  subgraph Reference["Reference data service"]
    NK[nike.com/gb + investors.nike.com\npublic pages, cited & dated] --> RC[src/reference/nike-catalogue.ts\nverified cache + fallback]
    RC --> RP[(reference_products\nreference_financials)]
  end

  subgraph Sim["Simulator engine (src/simulator)"]
    BOOT[bootstrap: seeded world] --> ENG[TickEngine\nads → sessions → orders → fulfilment → reviews]
    SCN[scenarios.ts\nmechanistic params] -.-> ENG
    RNG[sfc32 RNG state] <--> ENG
    RUN[runtime.ts\nlease lock · idempotent ticks · chunked persistence]
    ENG --> RUN
    CHK[checkout.ts\ntransaction + atomic stock]
  end

  subgraph Ing["Ingestion service"]
    ING[ingestBatch\nZod strict · eventBusinessRules · tenant scope\nunique (businessId, connectorId, sourceRecordId)]
  end

  subgraph Mongo["MongoDB normal_dev"]
    ST[(simulator_state)]
    DOM[(simulated_* domain records)]
    EV[(business_events\nimmutable ledger)]
    MS[(metric_snapshots)]
    GT[(simulator_ground_truth\nPRIVATE)]
    RCPT[(action_receipts)]
  end

  subgraph An["Analytics service"]
    AGG[computeSnapshots\n$facet aggregation · dedupe ad windows · null rates]
  end

  subgraph UI["Next.js app"]
    STORE[/demo-store\nstorefront + checkout/]
    CR[/dev/simulator\ncontrol room/]
  end

  subgraph API["Route handlers"]
    DEVAPI[/api/dev/simulator/*]
    INGAPI[/api/ingest/events]
    MET[/api/metrics, /api/metrics/breakdown]
    SHOP[/api/demo-store/*]
    PLANS[/api/plans/:id → PlanHandoff]
  end

  subgraph Partner["Partner adapters (src/adapters)"]
    AD[setDailyBudget · sendDelayNotice · publishBanner\nread-backs · verifyAction]
  end

