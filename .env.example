# Local only — copy to .env (gitignored). Never commit real values.

# MUBIT_BASE_URL=
# MUBIT_API_KEY=
# Data is stored as CSV files in ./data (override with NORMAL_DATA_DIR; NORMAL_STORE=memory disables persistence)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
# Required controlled inbox for both real providers. Never use customer addresses.
EMAIL_TEST_RECIPIENT=
# Leave unset to select Resend when configured, otherwise Ethereal.
# EMAIL_PROVIDER=ethereal
# EMAIL_PROVIDER=memory is permitted only with NODE_ENV=test.
MUBIT_BASE_URL=https://api.mubit.ai/openai/v1
MUBIT_MODEL=gpt-6-luna
APPROVAL_TTL_MINUTES=30
EXECUTION_STEP_DELAY_MS=600
INTELLIGENCE_API_URL=
MAX_DAILY_BUDGET_MINOR=10000
MAX_BUDGET_CHANGE_PERCENT=60

# Persistent notifications (scripts/notify-install.sh)
SPROUT_ROOT="/path/to/Sprout"
NOTIFY_ENABLED=1

# Cloudflare team hub (after ./scripts/cloud-deploy.sh)
HUB_URL=https://night-shift-team-hub.kiritokris.workers.dev
HUB_TOKEN=
