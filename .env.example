# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority"

# Database name (defaults to normal_dev if unset)
MONGODB_DB="normal_dev"

# --- Optional access controls (all default to "off") ---
# Simulator controls (/api/dev/*) are always available when NODE_ENV=development.
# To expose them in a deployed demo, set BOTH values and send header `x-normal-demo-key: <NORMAL_DEMO_KEY>`.
# NORMAL_DEMO_MODE="true"
# NORMAL_DEMO_KEY="choose-a-long-random-secret"

# External connectors posting to POST /api/ingest/events outside development send
# `Authorization: Bearer <NORMAL_INGEST_API_KEY>`.
# NORMAL_INGEST_API_KEY="choose-another-long-random-secret"

# Direct monitoring is enabled in development. Set false to demonstrate Change Streams alone;
# set true in a deployed demo. Ready windows remain durable regardless of this flag.
# NORMAL_AUTO_MONITOR="true"
# Run the independent watcher with `npm run monitor:watch` (check Atlas first: `npm run monitor:check`).

# Mubit investigator: every diagnosis call goes to Mubit's Gemini route (https://api.mubit.ai/gemini/v1beta,
# model gemini-4-argon). Without a key the "Run Mubit diagnosis" button answers 503 and nothing is saved.
MUBIT_API_KEY="mbt_..."
